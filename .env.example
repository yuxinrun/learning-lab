# Public site URL – used for canonical URLs, sitemap, RSS and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sub-path deployment, e.g. /learning-lab on GitHub Pages. Leave empty locally.
# NEXT_PUBLIC_BASE_PATH=

# Optional: newsletter provider endpoint. When absent the subscribe form clearly
# reports that no delivery service is connected (it never fakes success).
# NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
